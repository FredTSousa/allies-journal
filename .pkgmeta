package-as: AlliesJournal

# The addon lives in the AlliesJournal/ subfolder of this repo, so move its
# contents up to the package root. Everything else in the repo (README,
# workflow, assets) is ignored below and never ends up in the zip.
move-folders:
  AlliesJournal/AlliesJournal: AlliesJournal

# The libraries in AlliesJournal/Libs/ are committed to the repo, so nothing
# is fetched as an external at package time.

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - assets
  - README.md
